# OpenRouter API Key (احصل عليه مجاناً من https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model (النموذج المعتمد في وثيقة المتطلبات)
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Port configuration (يتم تمريره تلقائياً في Render عبر متغير البيئة PORT)
PORT=8000
HOST=0.0.0.0
